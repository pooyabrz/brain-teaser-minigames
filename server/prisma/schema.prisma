generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  name          String
  role          String   @default("PLAYER")
  createdAt     DateTime @default(now())
  records       Record[]
  arcadeSessions ArcadeSession[]
  favoriteGames Game[]   @relation("Favorites")
}

model Game {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String
  category     String   @default("Logic")
  difficulty   String   @default("Medium")
  icon         String   @default("puzzle")
  accent       String   @default("purple")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  records      Record[]
  favoredBy    User[]   @relation("Favorites")
}

model Record {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int
  score     Int
  elapsed   Int      @default(0)
  outcome   String   @default("completed")
  createdAt DateTime @default(now())
  @@index([gameId, score])
  @@index([userId, createdAt])
}

// Additive v2 data. Existing users, favorites and casual records are untouched.
model ArcadeSession {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String
  seed        String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  score       Int?
  actions     Json?
  xp          Int      @default(0)
  @@index([userId, createdAt])
  @@index([slug, score])
}
